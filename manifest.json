      "title": "Generate documents",
      "translations": {
        "pl": {
          "title": "Generuj dokumenty"
        }
      }
    },
    {
      "id": "recalculate-field",
      "version": 1,
      "kind": "action",
      "outlet": "record_attribute_action",
      "title": "Recalculate formulas…",
      "invoke": {
        "dialog": "recalculate-dialog"
      },
      "translations": {
        "pl": {
