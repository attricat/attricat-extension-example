    {
      "id": "recalculate-record",
      "version": 1,
      "kind": "action",
      "outlet": "record_action",
      "title": "Recalculate formulas",
      "invoke": {
        "command": "recalculate-action"
      },
      "translations": {
        "pl": {
          "title": "Przelicz formuły"
        }
      },
      "icon": "calculator",
      "when": {
        "requires_write": true
      }
    },
    {
      "id": "generate-record-document",
      "version": 1,
      "kind": "action",
      "outlet": "record_action",
