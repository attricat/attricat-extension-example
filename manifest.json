{
  "manifest_version": 1,
  "name": "Attricat Example Extension",
  "version": "0.12.0",
  "description": "Context-aware computed numeric attributes and PDF documents: a tour of the attricat:host 1.1 extension surface.",
  "icons": {
    "48": "assets/icon-48.svg"
  },
  "attricat": {
    "id": "attricat-extension-example",
    "host_api": ">=1.1.0, <2.0.0"
  },
  "permissions": [
    "attricat.read",
    "attricat.write",
    "attricat.annotations.write",
    "artifacts.write",
    "events.subscribe",
    "events.emit",
    "storage.extension",
    "configuration.write",
    "logging.write",
    "client.commands",
    "client.events",
    "client.navigation",
    "client.notification",
    "client.refresh",
    "client.record_action",
    "client.explorer_table_cell",
    "client.explorer_row_action",
    "client.explorer_bulk_action",
    "client.action_dialog",
    "client.operations.start",
    "client.operations.read",
    "client.operations.cancel",
    "client.blueprint_configuration",
    "client.blueprint_detail_panel",
    "client.data_health_card",
    "client.record_header_action",
    "client.explorer_action",
    "client.blueprint_panel",
    "client.blueprint_publish_check",
    "client.audit_event_panel",
    "client.record_field_notes"
  ],
  "artifacts": [
    {
      "id": "server",
      "kind": "server_wasm",
      "path": "dist/server.wasm"
    },
    {
      "id": "app",
      "kind": "client_component",
      "path": "dist/app.js"
    },
    {
      "id": "inspector",
      "kind": "client_component",
      "path": "dist/inspector.js"
    },
    {
      "id": "recalculate-dialog",
      "kind": "client_component",
      "path": "dist/recalculate-dialog.js"
    },
    {
      "id": "documents-dialog",
      "kind": "client_component",
      "path": "dist/documents-dialog.js"
    },
    {
      "id": "table-cell",
      "kind": "client_component",
      "path": "dist/table-cell.js"
    },
    {
      "id": "attribute-settings",
      "kind": "client_component",
      "path": "dist/attribute-settings.js"
    },
    {
      "id": "blueprint-panel",
      "kind": "client_component",
      "path": "dist/blueprint-panel.js"
    },
    {
      "id": "health-card",
      "kind": "client_component",
      "path": "dist/health-card.js"
    },
    {
      "id": "blueprint-summary",
      "kind": "client_component",
      "path": "dist/blueprint-summary.js"
    },
    {
      "id": "publish-check",
      "kind": "client_component",
      "path": "dist/publish-check.js"
    },
    {
      "id": "audit-panel",
      "kind": "client_component",
      "path": "dist/audit-panel.js"
    },
    {
      "id": "templates",
      "kind": "client_component",
      "path": "dist/templates.js"
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "scoped_configuration": {
    "version": 1,
    "scopes": [
      "attribute"
    ],
    "schema": {
      "type": "object",
      "properties": {
        "precision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "event_contracts": {
    "exports": [
      {
        "id": "formula-recalculated",
        "version": "1.0.0",
        "event_type": "plugin.attricat-extension-example.formula_recalculated.v1",
        "schema": {
          "type": "object",
          "required": [
            "record_id",
            "context_id",
            "target_code",
            "result"
          ],
          "properties": {
            "record_id": {
              "type": "string"
            },
            "context_id": {
              "type": "string"
            },
            "target_code": {
              "type": "string"
            },
            "result": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "max_payload_bytes": 1024
      }
    ]
  },
  "server": {
    "event_handlers": [
      {
        "id": "recalculate-on-attribute-change",
        "event_types": [
          "record.updated.v1"
        ],
        "handler": "handle-event"
      }
    ],
    "commands": [
      {
        "id": "describe-formulas",
        "handler": "describe-formulas",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "record_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "preview-formula",
        "handler": "preview-formula",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "expression": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "record_id",
            "context_id",
            "expression"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "recalculate-formulas",
        "handler": "recalculate-formulas",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "record_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "get-attribute-settings",
        "handler": "get-attribute-settings",
        "request_schema": {
          "type": "object",
          "properties": {
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer"
            },
            "attribute_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "required": [
            "blueprint_id",
            "blueprint_version",
            "attribute_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "save-attribute-settings",
        "handler": "save-attribute-settings",
        "request_schema": {
          "type": "object",
          "properties": {
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer"
            },
            "attribute_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "settings": {
              "type": "object",
              "properties": {
                "precision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "blueprint_id",
            "blueprint_version",
            "attribute_id",
            "settings"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "recent-activity",
        "handler": "recent-activity",
        "request_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "list-templates",
        "handler": "list-templates",
        "request_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "save-template",
        "handler": "save-template",
        "request_schema": {
          "type": "object",
          "required": [
            "template",
            "expected_version"
          ],
          "properties": {
            "template": {
              "type": "object",
              "required": [
                "id",
                "name",
                "title",
                "body"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,32}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "builtin": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "expected_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "delete-template",
        "handler": "delete-template",
        "request_schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "recalculate-action",
        "handler": "recalculate-action",
        "request_schema": {
          "type": "object",
          "required": [
            "action_id",
            "blueprint_id",
            "blueprint_version",
            "context_id",
            "record_ids"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            },
            "outlet": {
              "type": "string"
            },
            "context_version": {
              "type": "integer"
            },
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer",
              "minimum": 1
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "maxItems": 50
            },
            "locale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object",
          "required": [
            "notification",
            "refresh"
          ],
          "properties": {
            "notification": {
              "type": "object",
              "required": [
                "message",
                "severity"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "refresh": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "id": "check-formulas-action",
        "handler": "check-formulas-action",
        "request_schema": {
          "type": "object",
          "required": [
            "action_id",
            "blueprint_id",
            "blueprint_version",
            "context_id",
            "record_ids"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            },
            "outlet": {
              "type": "string"
            },
            "context_version": {
              "type": "integer"
            },
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer",
              "minimum": 1
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "maxItems": 50
            },
            "locale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object",
          "required": [
            "notification",
            "refresh"
          ],
          "properties": {
            "notification": {
              "type": "object",
              "required": [
                "message",
                "severity"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "refresh": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "id": "list-formulas-action",
        "handler": "list-formulas-action",
        "request_schema": {
          "type": "object",
          "required": [
            "action_id",
            "blueprint_id",
            "blueprint_version",
            "context_id",
            "record_ids"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            },
            "outlet": {
              "type": "string"
            },
            "context_version": {
              "type": "integer"
            },
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer",
              "minimum": 1
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "maxItems": 50
            },
            "locale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object",
          "required": [
            "notification",
            "refresh"
          ],
          "properties": {
            "notification": {
              "type": "object",
              "required": [
                "message",
                "severity"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "refresh": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "id": "describe-fields",
        "handler": "describe-fields",
        "request_schema": {
          "type": "object",
          "required": [
            "records",
            "context_id",
            "locale"
          ],
          "properties": {
            "records": {
              "type": "array",
              "maxItems": 25,
              "items": {
                "type": "object",
                "required": [
                  "record_id",
                  "blueprint_id",
                  "blueprint_version"
                ],
                "properties": {
                  "record_id": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  },
                  "blueprint_id": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  },
                  "blueprint_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "context_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "locale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        },
        "max_response_bytes": 65536
      },
      {
        "id": "open-workbench-action",
        "handler": "open-workbench-action",
        "request_schema": {
          "type": "object",
          "required": [
            "action_id",
            "blueprint_id",
            "blueprint_version",
            "context_id",
            "record_ids"
          ],
          "properties": {
            "action_id": {
              "type": "string"
            },
            "outlet": {
              "type": "string"
            },
            "context_version": {
              "type": "integer"
            },
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer",
              "minimum": 1
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "maxItems": 50
            },
            "locale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      }
    ],
    "operations": [
      {
        "id": "recalculate-selection",
        "handler": "recalculate-selection",
        "request_schema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "write",
                "report"
              ]
            }
          },
          "additionalProperties": false
        },
        "max_request_bytes": 256,
        "max_checkpoint_bytes": 4096,
        "interactive": {
          "version": 1,
          "max_selection": 50
        }
      },
      {
        "id": "generate-documents",
        "handler": "generate-documents",
        "request_schema": {
          "type": "object",
          "required": [
            "template",
            "template_version",
            "output"
          ],
          "properties": {
            "template": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            },
            "template_version": {
              "type": "integer",
              "minimum": 1
            },
            "output": {
              "type": "string",
              "enum": [
                "individual",
                "zip",
                "combined"
              ]
            }
          },
          "additionalProperties": false
        },
        "max_request_bytes": 1024,
        "max_checkpoint_bytes": 65536,
        "interactive": {
          "version": 1,
          "max_selection": 50
        }
      }
    ]
  },
  "ui": [
    {
      "id": "formula-workbench",
      "version": 1,
