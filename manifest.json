{
  "manifest_version": 1,
  "name": "Attricat Example Extension",
  "version": "0.9.1",
  "description": "Context-aware computed numeric attributes and PDF documents: a tour of the attricat:host 1.1 extension surface.",
  "icons": {
    "48": "assets/icon-48.svg"
  },
  "attricat": {
    "id": "attricat-extension-example",
    "host_api": ">=1.1.0, <2.0.0"
  },
  "permissions": [
    "attricat.read",
    "attricat.write",
    "attricat.annotations.write",
    "artifacts.write",
    "events.subscribe",
    "events.emit",
    "storage.extension",
    "configuration.write",
    "logging.write",
    "client.commands",
    "client.events",
    "client.navigation",
    "client.notification",
    "client.refresh",
    "client.record_decoration",
    "client.record_action",
    "client.explorer_table_cell",
    "client.explorer_row_action",
    "client.explorer_bulk_action",
    "client.action_dialog",
    "client.operations.start",
    "client.operations.read",
    "client.operations.cancel",
    "client.blueprint_configuration",
    "client.record_attribute_panel",
    "client.blueprint_detail_panel",
    "client.data_health_card",
    "client.record_header_action",
    "client.explorer_action",
    "client.blueprint_panel",
    "client.blueprint_publish_check",
    "client.file_panel",
    "client.audit_event_panel"
  ],
  "artifacts": [
    {
      "id": "server",
      "kind": "server_wasm",
      "path": "dist/server.wasm"
    },
    {
      "id": "app",
      "kind": "client_component",
      "path": "dist/app.js"
    },
    {
      "id": "inspector",
      "kind": "client_component",
      "path": "dist/inspector.js"
    },
    {
      "id": "decoration",
      "kind": "client_component",
      "path": "dist/decoration.js"
    },
    {
      "id": "record-action",
      "kind": "client_component",
      "path": "dist/record-action.js"
    },
    {
      "id": "selection-action",
      "kind": "client_component",
      "path": "dist/selection-action.js"
    },
    {
      "id": "dialog",
      "kind": "client_component",
      "path": "dist/dialog.js"
    },
    {
      "id": "table-cell",
      "kind": "client_component",
      "path": "dist/table-cell.js"
    },
    {
      "id": "attribute-settings",
      "kind": "client_component",
      "path": "dist/attribute-settings.js"
    },
    {
      "id": "attribute-panel",
      "kind": "client_component",
      "path": "dist/attribute-panel.js"
    },
    {
      "id": "blueprint-panel",
      "kind": "client_component",
      "path": "dist/blueprint-panel.js"
    },
    {
      "id": "health-card",
      "kind": "client_component",
      "path": "dist/health-card.js"
    },
    {
      "id": "header-action",
      "kind": "client_component",
      "path": "dist/header-action.js"
    },
    {
      "id": "explorer-action",
      "kind": "client_component",
      "path": "dist/explorer-action.js"
    },
    {
      "id": "blueprint-summary",
      "kind": "client_component",
      "path": "dist/blueprint-summary.js"
    },
    {
      "id": "publish-check",
      "kind": "client_component",
      "path": "dist/publish-check.js"
    },
    {
      "id": "file-panel",
      "kind": "client_component",
      "path": "dist/file-panel.js"
    },
    {
      "id": "audit-panel",
      "kind": "client_component",
      "path": "dist/audit-panel.js"
    },
    {
      "id": "templates",
      "kind": "client_component",
      "path": "dist/templates.js"
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "scoped_configuration": {
    "version": 1,
    "scopes": [
      "attribute"
    ],
    "schema": {
      "type": "object",
      "properties": {
        "precision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "event_contracts": {
    "exports": [
      {
        "id": "formula-recalculated",
        "version": "1.0.0",
        "event_type": "plugin.attricat-extension-example.formula_recalculated.v1",
        "schema": {
          "type": "object",
          "required": [
            "record_id",
            "context_id",
            "target_code",
            "result"
          ],
          "properties": {
            "record_id": {
              "type": "string"
            },
            "context_id": {
              "type": "string"
            },
            "target_code": {
              "type": "string"
            },
            "result": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "max_payload_bytes": 1024
      }
    ]
  },
  "server": {
    "event_handlers": [
      {
        "id": "recalculate-on-attribute-change",
        "event_types": [
          "record.updated.v1"
        ],
        "handler": "handle-event"
      }
    ],
    "commands": [
      {
        "id": "describe-formulas",
        "handler": "describe-formulas",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "record_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "preview-formula",
        "handler": "preview-formula",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "expression": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "record_id",
            "context_id",
            "expression"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "recalculate-formulas",
        "handler": "recalculate-formulas",
        "request_schema": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "context_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "record_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "get-attribute-settings",
        "handler": "get-attribute-settings",
        "request_schema": {
          "type": "object",
          "properties": {
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer"
            },
            "attribute_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "required": [
            "blueprint_id",
            "blueprint_version",
            "attribute_id"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "save-attribute-settings",
        "handler": "save-attribute-settings",
        "request_schema": {
          "type": "object",
          "properties": {
            "blueprint_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "blueprint_version": {
              "type": "integer"
            },
            "attribute_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "settings": {
              "type": "object",
              "properties": {
                "precision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "blueprint_id",
            "blueprint_version",
            "attribute_id",
            "settings"
          ],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "recent-activity",
        "handler": "recent-activity",
        "request_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "list-templates",
        "handler": "list-templates",
        "request_schema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "save-template",
        "handler": "save-template",
        "request_schema": {
          "type": "object",
          "required": [
            "template",
            "expected_version"
          ],
          "properties": {
            "template": {
              "type": "object",
              "required": [
                "id",
                "name",
                "title",
                "body"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,32}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "builtin": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "expected_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "delete-template",
        "handler": "delete-template",
        "request_schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            }
          },
          "additionalProperties": false
        },
        "response_schema": {
          "type": "object"
        }
      }
    ],
    "operations": [
      {
        "id": "recalculate-selection",
        "handler": "recalculate-selection",
        "request_schema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "write",
                "report"
              ]
            }
          },
          "additionalProperties": false
        },
        "max_request_bytes": 256,
        "max_checkpoint_bytes": 4096,
        "interactive": {
          "version": 1,
          "max_selection": 50
        }
      },
      {
        "id": "generate-documents",
        "handler": "generate-documents",
        "request_schema": {
          "type": "object",
          "required": [
            "template",
            "template_version",
            "output"
          ],
          "properties": {
            "template": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            },
            "template_version": {
              "type": "integer",
              "minimum": 1
            },
            "output": {
              "type": "string",
              "enum": [
                "individual",
                "zip",
                "combined"
              ]
            }
          },
          "additionalProperties": false
        },
        "max_request_bytes": 1024,
        "max_checkpoint_bytes": 65536,
        "interactive": {
          "version": 1,
          "max_selection": 50
        }
      }
    ]
  },
  "ui": [
    {
      "id": "formula-workbench",
      "version": 1,
      "kind": "route",
      "artifact": "app",
      "title": "Formula workbench"
    },
    {
      "id": "formula-workbench-nav",
      "version": 1,
      "kind": "navigation",
      "route": "formula-workbench",
      "title": "Formula workbench"
    },
    {
      "id": "document-templates",
      "version": 1,
      "kind": "route",
      "artifact": "templates",
      "title": "Document templates"
    },
    {
      "id": "document-templates-nav",
      "version": 1,
      "kind": "navigation",
      "route": "document-templates",
      "title": "Document templates"
    },
    {
      "id": "formula-inspector",
      "version": 1,
      "kind": "embedded",
      "artifact": "inspector",
      "outlet": "record_preview_panel"
    },
    {
      "id": "computed-value-indicator",
      "version": 1,
      "kind": "embedded",
      "artifact": "decoration",
      "outlet": "record_attribute_decoration"
    },
    {
      "id": "record-actions",
      "version": 2,
      "kind": "embedded",
      "artifact": "record-action",
      "outlet": "record_action"
    },
    {
      "id": "attricat-extension-example.computed-number",
      "version": 1,
      "kind": "embedded",
      "artifact": "table-cell",
      "outlet": "explorer_table_cell"
    },
    {
      "id": "selection-row",
      "version": 2,
      "kind": "action",
      "artifact": "selection-action",
      "outlet": "explorer_row_action"
    },
    {
      "id": "selection-bulk",
      "version": 2,
      "kind": "action",
      "artifact": "selection-action",
      "outlet": "explorer_bulk_action"
    },
    {
      "id": "selection-dialog",
      "version": 1,
      "kind": "dialog",
      "artifact": "dialog",
      "outlet": "action_dialog",
      "title": "Formulas and documents"
    },
    {
      "id": "formula-settings",
      "version": 1,
      "kind": "embedded",
      "artifact": "attribute-settings",
      "outlet": "blueprint_attribute_configuration"
    },
    {
      "id": "formula-attribute-panel",
      "version": 1,
      "kind": "panel",
      "artifact": "attribute-panel",
      "outlet": "record_attribute_panel"
    },
    {
      "id": "formula-blueprint-panel",
      "version": 1,
      "kind": "panel",
      "artifact": "blueprint-panel",
      "outlet": "blueprint_detail_panel"
    },
    {
      "id": "formula-health-card",
      "version": 1,
      "kind": "panel",
      "artifact": "health-card",
      "outlet": "data_health_card"
    },
    {
      "id": "formula-header-action",
      "version": 1,
      "kind": "action",
      "artifact": "header-action",
      "outlet": "record_header_action"
    },
    {
      "id": "formula-explorer-action",
      "version": 1,
      "kind": "action",
      "artifact": "explorer-action",
      "outlet": "explorer_action"
    },
    {
      "id": "formula-blueprint-summary",
      "version": 1,
      "kind": "panel",
      "artifact": "blueprint-summary",
      "outlet": "blueprint_panel"
    },
    {
      "id": "formula-publish-check",
      "version": 1,
      "kind": "panel",
      "artifact": "publish-check",
      "outlet": "blueprint_publish_check"
    },
    {
      "id": "document-file-panel",
      "version": 1,
      "kind": "panel",
      "artifact": "file-panel",
      "outlet": "file_panel"
    },
    {
      "id": "formula-audit-panel",
      "version": 1,
      "kind": "panel",
      "artifact": "audit-panel",
      "outlet": "audit_event_panel"
    }
  ],
  "cell_renderers": [
    {
      "id": "attricat-extension-example.computed-number",
      "version": 1,
      "value_types": [
        "number",
        "integer"
      ],
      "allowed_props": [
        "precision",
        "unit"
      ]
    }
  ]
}
